# Only authored source, tests, tools, documents and portable SDK changes.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/*.cmd
!/*.txt
!/*.code-workspace
!/.githooks/
!/Source/
!/Tests/
!/tools/
!/docs/
!/patches/
!/validators/
!/evidence/

# Local original/vendor inputs and the materialized SDK are not repository payloads.
/Source/Assets/
/Source/SDK_BNW_Original/
/Source/SDK_BNW_x64/
/Source/ThirdParty/
/Source/Host/UiPopupAssets.generated.h

# Evidence also contains authored build/analysis scripts. Keep code, not run data.
/evidence/**
!/evidence/**/
!/evidence/**/*.py
!/evidence/**/*.cpp
!/evidence/**/*.c
!/evidence/**/*.patch
!/evidence/**/HANDOFF_RESULT.md
!/evidence/world_terrain_original/claude_geometry/*.h
!/evidence/world_terrain_original/claude_geometry/findings.json
!/evidence/world_terrain_original/claude_geometry/basis_retail_probe.json
/evidence/**/frozen/
/evidence/**/frozen_inputs/
/evidence/**/source_before/
/evidence/**/compiler_tree/
/evidence/**/include_roots/
/evidence/**/external/
/evidence/**/work/
/evidence/**/build/
/evidence/**/parallel_work/
/evidence/version_control/

/validators/**
!/validators/**/
!/validators/**/*.py
!/validators/**/*.cpp

# Reproducible payloads, game assets, saves, captures and local environments.
**/__pycache__/
**/.vs/
**/node_modules/
**/.venv/
*.pyc
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.bin
*.packet
*.dds
*.gr2
*.fpk
*.fxsb
*.cso
*.dxbc
*.rdc
*.dmp
*.zip
*.7z
*.gz
*.log
*.db
*.sqlite
*.sqlite3
*.Civ5Save
*.Civ5Map
*.save
.env
.env.*
credentials.json
id_rsa
id_ed25519
