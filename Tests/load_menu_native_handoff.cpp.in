static unsigned checks=0,cases=0;
static std::vector<std::string> events;
static void Check(bool condition,const char* message){++checks;if(!condition)throw std::runtime_error(message);}
template<class F> static void Throws(F&& operation,const char* message){
    bool failed=false;try{operation();}catch(const std::exception&){failed=true;}Check(failed,message);
}
template<class F> static void Case(const char* name,F&& operation){
    operation();++cases;std::printf("HANDOFF_CASE_PASS=%s\n",name);
}
static std::size_t Event(const std::string& value,std::size_t from=0){
    const auto found=std::find(events.begin()+static_cast<std::ptrdiff_t>(from),events.end(),value);
    if(found==events.end())throw std::runtime_error("Missing lifecycle event: "+value);
    return static_cast<std::size_t>(found-events.begin());
}
