static InteractiveGameSession::LoadHandoff RunInteractiveGameLoop(SessionFixture& session,HostState&,InteractiveGameSession& live,
    const std::wstring&,bool smoke,const std::wstring&,const std::wstring&,bool,std::shared_ptr<const NativeSaveArchive> decodedArchive){
    events.push_back("LoopEnter");++loopCalls;if(decodedArchive)routedArchives.push_back(decodedArchive.get());
    WindowFixture window;DeferredFixture deferredEditorInput;std::wstring error;
    InteractiveGameSession::LoadHandoff loadHandoff;
    if(loopResults.empty())throw std::runtime_error("Fixture loop sequence exhausted");
    loadHandoff=std::move(loopResults.front());loopResults.pop_front();
    // In the no-result fixture, exercise the actual production dispatch bridge
    // only when a test has supplied an original callback request.
    if(!loadHandoff.archive && live.ui_->kind_==UiPopupKind::LoadMenu){
        std::vector<ZeroSisPresentation::BitmapInputEvent> inputs(1);bool acted=false;
        session.WithCore([&](ICvGameContext3&){
            for(const auto& input:inputs){@@LOOP_DISPATCH@@}
            @@LOOP_GATE@@
            ++ticks;
        });
        (void)acted;
    }
    @@LOOP_EXIT@@
    return {};
}
