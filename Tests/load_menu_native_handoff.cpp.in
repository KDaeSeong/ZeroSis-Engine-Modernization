class UiFixture {
public:
    explicit UiFixture(HostState& host):host_(host),popup_(new PopupFixture){}
    HostState& host_;std::unique_ptr<PopupFixture> popup_,suspendedGameMenu_;
    std::vector<int> pending_;UiPopupKind kind_=UiPopupKind::GameMenu;
    std::vector<LoadMenuRequest> nextRequests,committed;
    unsigned updates=0,finishes=0;bool mandatory=false;
    @@UI_REQUIRE@@
    bool HasModal()const{return (popup_ && popup_->active) || !!suspendedGameMenu_;}
    bool IsActive()const{return popup_ && popup_->active;}
    UiPopupKind ActiveKind()const{return kind_;}
    bool HasCaptureDecision()const{return mandatory;}bool HasLeaderDecision()const{return false;}
    bool Dispatch(const ZeroSisPresentation::BitmapInputEvent&){
        events.push_back("CallbackComplete");committed=std::move(nextRequests);
        if(!committed.empty())popup_->active=false;return true;
    }
    std::vector<LoadMenuRequest> TakeLoadMenuRequests(){auto value=std::move(committed);committed.clear();return value;}
    std::vector<SaveMenuRequest> TakeSaveMenuRequests(){return {};}
    std::vector<GameMenuRequest> TakeGameMenuRequests(){return {};}
    bool Update(){
        ++updates;events.push_back("UiUpdate");
        if(kind_==UiPopupKind::LoadMenu && !popup_->active){
            popup_=std::move(suspendedGameMenu_);kind_=UiPopupKind::GameMenu;host_.popupVisible=true;
        }else if(kind_==UiPopupKind::GameMenu && popup_ && !popup_->active)popup_.reset();
        return true;
    }
    void CloseCurrent(){++finishes;events.push_back("ParentClose");popup_->active=false;host_.popupVisible=false;}
    @@FINISH@@
    void BeginLoad(){suspendedGameMenu_=std::move(popup_);popup_.reset(new PopupFixture);kind_=UiPopupKind::LoadMenu;host_.popupVisible=true;}
};

