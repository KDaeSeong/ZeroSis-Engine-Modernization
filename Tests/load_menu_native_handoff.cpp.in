    using namespace ZeroSisHost;events.clear();factories=loopCalls=ticks=0;coreAlive=shutdownFailure=false;
    loopResults.clear();routedArchives.clear();
}

int main(){
    SetErrorMode(SEM_FAILCRITICALERRORS|SEM_NOGPFAULTERRORBOX|SEM_NOOPENFILEERRORBOX);
    DWORD wer=0;
    if(FAILED(WerSetFlags(WER_FAULT_REPORTING_NO_UI)) || FAILED(WerGetFlags(GetCurrentProcess(),&wer)) ||
       GetErrorMode()!=32771 || wer!=32)return 2;
    std::puts("FAULT_UI_SUPPRESSED ERROR_MODE=32771 WER_FLAGS=32");
    std::puts("SDK_UI_WINDOW_AND_FACTORY_DEPENDENCIES_ARE_FIXTURES GAMECORE_ACTUAL_LOADED=false HWND_CREATED=false");
    try{
        using namespace ZeroSisHost;
        Case("actual-router-window-close-preserves-one-original-close",[]{
            for(unsigned open=0;open<2;++open){
                events.clear();auto host=Host();WindowCloseUiBoundaryFixture ui(*host);
                if(open)Check(ui.popup_->DispatchInput(UiInputKind::LeftClick,101),"PullDown fixture did not open");
                Check(ui.popup_->pullDownOpen==(open!=0),"PullDown callback fixture state mismatch");
                ui.CloseAll();
                Check(!ui.popup_ && !ui.suspendedGameMenu_ && !host->popupVisible,"normal window close retained a modal owner");
                Check(ui.observedTakeCalls==1 && ui.observedCloseCount==1,"window close did not consume exactly one original Close");
                Check(ui.observedEscapes==1+open && ui.observedQueuedClose==1,"Escape collapsed/closed more than the original scopes");
                Check(ui.takeAfterCallback && ui.discardCalls==1,"router Take ran during a callback or failed final cleanup");
                Check(std::count(events.begin(),events.end(),"LuaThreadFreed")==2,"window close did not release child then parent exactly once");
            }
        });
        Case("normal-close-keeps-committed-request-until-take",[]{
            auto host=Host();LoadPopupBoundaryFixture popup(*host);popup.OpenLoadMenu();
            popup.DispatchInput(UiInputKind::LeftClick,101);
            unsigned callbackTakeRejections=0;
            popup.insideCloseCallback=[&](LoadPopupBoundaryFixture& child){
                Throws([&]{child.TakeLoadMenuRequests();},"Take consumed a request inside its original callback");++callbackTakeRejections;
            };
            popup.CloseInformationalPopup();
            Check(callbackTakeRejections==1 && !popup.active_ && popup.HasPendingLoadMenuRequests(),"normal close lost its completed request");
            Check(popup.escapes==2 && popup.queuedClose==1 && popup.loadMenuReady_,"two Escape steps did not publish one Close");
            const auto callbacks=popup.completedCallbacks;popup.CloseInformationalPopup();
            Check(popup.completedCallbacks==callbacks && popup.HasPendingLoadMenuRequests(),"repeated close erased or repeated a committed callback");
            const auto requests=popup.TakeLoadMenuRequests();
            Check(requests.size()==1 && requests[0].kind==LoadMenuRequest::Kind::Close && requests[0].owner==1 && requests[0].turn==3 && requests[0].fileName.empty(),"Take returned an invalid original Close");
            Check(!popup.HasPendingLoadMenuRequests() && popup.TakeLoadMenuRequests().empty(),"Close was consumed more than once");
            popup.Stop();
        });
        Case("normal-close-preserves-already-committed-load-close-and-cursor",[]{
            auto host=Host();LoadPopupBoundaryFixture popup(*host);popup.OpenLoadMenu();
            Check(popup.DispatchInput(UiInputKind::LeftClick,202),"load callback fixture did not commit");
            popup.CloseInformationalPopup();
            Check(popup.HasPendingLoadMenuRequests() && popup.loadMenuCursorToken_==1 && popup.cursorRestores==0,"normal close discarded committed load/cursor ownership");
            const auto requests=popup.TakeLoadMenuRequests();
            Check(requests.size()==2 && requests[0].kind==LoadMenuRequest::Kind::Load && requests[1].kind==LoadMenuRequest::Kind::Close,"normal close reordered a completed load callback");
            Check(!popup.HasPendingLoadMenuRequests() && popup.loadMenuCursorToken_==0 && popup.cursorRestores==1,"verified Take failed to release cursor exactly once");
            popup.Stop();
        });
        Case("actual-stop-discards-active-and-committed-child-requests",[]{
            for(unsigned committed=0;committed<2;++committed){
                events.clear();auto host=Host();LoadPopupBoundaryFixture popup(*host);popup.OpenLoadMenu();
                popup.DispatchInput(UiInputKind::LeftClick,committed?202:101);
                popup.Stop();
                Check(popup.stopping_ && !popup.vm_ && !popup.core_ && !popup.game_ && !popup.pregame_,"Stop did not release the child VM boundary");
                Check(popup.loadMenuRequests_.empty() && !popup.loadMenuReady_ && !popup.loadMenuInput_ && popup.loadMenuCursorToken_==0,"Stop exposed a discarded request or busy cursor");
                Check(popup.queuedClose==1 && popup.escapes==(committed?0u:2u),"Stop invented or duplicated a load/back callback");
                Check(std::count(events.begin(),events.end(),"LuaThreadFreed")==1,"Stop released a child more than once");
                popup.Stop();Check(std::count(events.begin(),events.end(),"LuaThreadFreed")==1,"second Stop repeated VM release");
            }
        });
        Case("actual-fault-discards-request-from-failed-close-callback",[]{
            events.clear();auto host=Host();LoadPopupBoundaryFixture popup(*host);popup.OpenLoadMenu();popup.failAfterQueued=true;
            Throws([&]{popup.CloseInformationalPopup();},"failed Lua callback fixture became a normal close");
            Check(popup.faulted_ && !popup.active_ && !host->popupVisible,"Fault retained a visible failed callback");
            Check(popup.queuedClose==1 && popup.loadMenuRequests_.empty() && !popup.loadMenuReady_ && !popup.loadMenuInput_ && !popup.dispatching_,"Fault leaked an uncommitted Close");
            Check(host->scripts->IsQuiescent() && popup.timerState_==LoadPopupBoundaryFixture::TimerState::Released,"Fault left callback/timer ownership unsettled");
            Throws([&]{popup.TakeLoadMenuRequests();},"faulted callback was handed to the session");
            popup.Stop();Check(!popup.vm_ && std::count(events.begin(),events.end(),"LuaThreadFreed")==1,"faulted child was not released exactly once");
        });
        Case("actual-fault-discards-committed-load-and-restores-cursor-once",[]{
            auto host=Host();LoadPopupBoundaryFixture popup(*host);popup.OpenLoadMenu();popup.DispatchInput(UiInputKind::LeftClick,202);
            popup.Fault();
            Check(popup.loadMenuRequests_.empty() && !popup.loadMenuReady_ && !popup.loadMenuInput_ && popup.loadMenuCursorToken_==0 && popup.cursorRestores==1,"Fault did not discard committed load/cursor ownership");
            popup.Fault();Check(popup.cursorRestores==1 && popup.game_->timerDecrements==0,"repeat Fault restored cursor/timer twice");
            popup.Stop();Check(popup.cursorRestores==1 && !popup.vm_,"faulted Stop repeated cursor release");
        });
        Case("window-close-rejects-an-already-committed-load-command",[]{
            auto host=Host();WindowCloseUiBoundaryFixture ui(*host);ui.popup_->DispatchInput(UiInputKind::LeftClick,202);
            Throws([&]{ui.CloseAll();},"window close silently discarded a pending load as normal Close");
            Check(ui.popup_ && ui.suspendedGameMenu_ && ui.observedCloseCount==0,"rejected window close released the retained parent");
            ui.popup_->Stop();ui.popup_.reset();ui.suspendedGameMenu_->Stop();ui.suspendedGameMenu_.reset();
        });
        Case("current-catalog-profile-and-immutable-list",[]{
            InteractiveGameSession live(Host());const auto snapshot=live.CaptureLoadMenuCatalog();
            Check(snapshot->profile==UiLoadMenuCatalog::Profile::OwnedCurrentExactBundleNoAdditionalContent,"missing verified fixture profile");
            Check(snapshot->canLoad(snapshot->files[0].fileName),"known exact archive rejected");
            Check(!snapshot->canLoad("C:\\outside.zssave"),"unknown path accepted");
            live.saveCatalog_->listed[0].observedFileIdentity[2]++;
            Check(!snapshot->canLoad(snapshot->files[0].fileName),"listed identity was silently refreshed");
        });
        Case("nonempty-active-mod-profile-rejected",[]{
            InteractiveGameSession live(Host());live.host_.activeMods->count=1;
            Throws([&]{live.CaptureLoadMenuCatalog();},"inferred an empty mod profile");
        });
        Case("load-close-seals-after-callback-before-parent-release",[]{
            events.clear();InteractiveGameSession live(Host());live.Ready();
            const auto expected=live.saveCatalog_->current;live.ui_->nextRequests=live.LoadPair();
            Check(live.DispatchUi({}),"production Load dispatch rejected");
            Check(Event("CallbackComplete")<Event("SealArchive",Event("CallbackComplete")),"sealed before callback returned");
            Check(Event("SealArchive",Event("CallbackComplete"))<Event("ParentClose"),"released parent before immutable seal");
            Check(live.game_->updates==0 && live.ui_->finishes==1,"load advanced SDK or missed original parent close");
            auto handoff=live.TakePendingLoad();
            Check(handoff.archive.get()==expected.get() && handoff.fileName.find(L'\uc800')!=std::wstring::npos,"immutable identity/UTF-8 source changed");
            live.saveCatalog_->current=std::make_shared<const NativeSaveArchive>(99);
            Check(handoff.archive->identity==42,"post-handoff catalog change replaced the selected archive");
            Check(!live.TakePendingLoad().archive && !live.loadMenuCatalog_,"handoff was consumed more than once");
        });
        Case("close-only-returns-parent-without-load",[]{
            InteractiveGameSession live(Host());live.Ready();live.ui_->nextRequests={{LoadMenuRequest::Kind::Close,1,3,{}}};
            live.DispatchUi({});Check(!live.HasPendingLoad() && live.ui_->HasModal() && live.ui_->finishes==0,"Back destroyed parent or created load");
        });
        Case("callback-order-owner-turn-and-close-identity",[]{
            const auto invalid=[](unsigned kind){
                InteractiveGameSession live(Host());live.Ready();auto requests=live.LoadPair();
                if(kind==0)std::reverse(requests.begin(),requests.end());
                if(kind==1)requests.resize(1);
                if(kind==2)requests.push_back(requests.back());
                if(kind==3)requests[0].owner=2;
                if(kind==4)requests[0].turn=4;
                if(kind==5)requests[1].fileName="bad-close";
                live.ui_->nextRequests=requests;
                Throws([&]{live.DispatchUi({});},"invalid callback transaction accepted");
                Check(!live.HasPendingLoad() && live.ui_->finishes==0,"bad request released original parent");
            };
            for(unsigned kind=0;kind<6;++kind)invalid(kind);
        });
        Case("changed-file-and-missing-preview-fail-before-teardown",[]{
            for(unsigned kind=0;kind<4;++kind){
                InteractiveGameSession live(Host());live.Ready();auto requests=live.LoadPair();
                if(kind==0)live.saveCatalog_->fail=true;
                if(kind==1)requests[0].fileName="C:\\unknown.zssave";
                if(kind==2){auto replacement=std::make_shared<UiLoadMenuCatalog>(*live.loadMenuCatalog_);replacement->files[0].header.reset();live.loadMenuCatalog_=replacement;}
                if(kind==3){auto replacement=std::make_shared<UiLoadMenuCatalog>(*live.loadMenuCatalog_);replacement->profile=UiLoadMenuCatalog::Profile::Unknown;live.loadMenuCatalog_=replacement;}
                live.ui_->nextRequests=requests;
                Throws([&]{live.DispatchUi({});},"unverified archive request accepted");
                Check(!live.HasPendingLoad() && live.ui_->finishes==0,"failed seal tore down original parent");
            }
        });
        Case("owner-lock-quiescence-human-and-autosave-guards",[]{
            for(unsigned kind=0;kind<7;++kind){
                InteractiveGameSession live(Host());live.Ready();live.ui_->nextRequests=live.LoadPair();
                if(kind==0)live.host_.gameThread=GetCurrentThreadId()+1;
                if(kind==1)live.host_.gameLock.held=false;
                if(kind==2)live.host_.scripts->quiescent=false;
                if(kind==3)live.host_.localCommands.quiescent=false;
                if(kind==4)live.human=false;
                if(kind==5)live.host_.autoSaveRunning=true;
                if(kind==6)live.ui_->mandatory=true;
                Throws([&]{live.DispatchUi({});},"unsettled owner request accepted");
                Check(!live.pendingLoad_.archive && live.ui_->finishes==0,"unsettled request released parent");
            }
        });
        Case("pending-load-take-rechecks-world-exit",[]{
            InteractiveGameSession live(Host());live.Ready();live.ui_->nextRequests=live.LoadPair();live.DispatchUi({});
            const auto original=live.pendingLoad_.archive;
            live.host_.popupVisible=true;
            Throws([&]{live.TakePendingLoad();},"visible parent escaped through handoff");
            Check(live.pendingLoad_.archive==original,"rejected Take consumed immutable data");
            live.host_.popupVisible=false;Check(live.TakePendingLoad().archive==original,"settled Take changed archive");
        });
        Case("archive-routing-never-reopens-selected-path",[]{
            pathRestores=archiveRestores=0;restoredAddress=nullptr;
            InteractiveGameSession live(Host());live.game_.reset();ICvGameContext3 context;
            auto archive=std::make_shared<const NativeSaveArchive>(42);live.Begin(context,L"diagnostic-only-removed-path",archive);
            Check(archiveRestores==1 && pathRestores==0 && restoredAddress==archive.get() && live.usedRestored_==archive,"decoded archive was copied/reopened");
            InteractiveGameSession pathLive(Host());pathLive.game_.reset();pathLive.Begin(context,L"CLI-checkpoint");
            Check(pathRestores==1 && pathLive.usedRestored_->identity==77,"existing CLI path restore changed");
        });
        Case("actual-loop-dispatch-barrier-prevents-extra-tick",[]{
            ResetLifecycle();auto host=Host();InteractiveGameSession live(host);live.Ready();live.ui_->nextRequests=live.LoadPair();
            loopResults.push_back({});SessionFixture session;
            auto value=RunInteractiveGameLoop(session,*host,live,L"",false,L"",L"",false,{});
            Check(value.archive && ticks==0 && live.game_->updates==0,"load fell through into Tick/game Update");
            Check(Event("EditorClear")<Event("WindowDestroyed"),"window outlived the loop return boundary");
        });
        Case("fresh-host-order-and-same-archive-across-two-loads",[]{
            ResetLifecycle();auto first=std::make_shared<const NativeSaveArchive>(101),second=std::make_shared<const NativeSaveArchive>(202);
            loopResults.push_back({first,L"first-diagnostic"});loopResults.push_back({second,L"second-diagnostic"});loopResults.push_back({});
            std::unique_ptr<HostRun> run(new HostRun(ExecutableDirectory()));run->Prepare("en_US");run->InitializeCore();
            Check(PlayBlock(run)==0,"actual HostMain play block failed");
            Check(factories==3 && loopCalls==3 && routedArchives.size()==2 && routedArchives[0]==first.get() && routedArchives[1]==second.get(),"fresh factory or immutable archive sequence changed");
            auto at=Event("WindowDestroyed");at=Event("LiveStop",at);at=Event("CoreShutdown",at);at=Event("RequireAbsent",at);
            at=Event("DestroyHost",at);at=Event("CreateHost",at);at=Event("PrepareHost",at);at=Event("InitializeCore",at);
            Check(at<Event("LoopEnter",at),"new loop ran before fresh initialization");
            Check(!coreAlive && !run->state_,"normal transition retained old core state");run.reset();
        });
        Case("cleanup-failure-prevents-new-host-creation",[]{
            ResetLifecycle();loopResults.push_back({std::make_shared<const NativeSaveArchive>(88),L"diagnostic"});
            std::unique_ptr<HostRun> run(new HostRun(ExecutableDirectory()));run->Prepare("en_US");run->InitializeCore();shutdownFailure=true;
            Throws([&]{PlayBlock(run);},"failed old shutdown still loaded another session");
            Check(factories==1 && run && coreAlive,"old cleanup failure discarded its owner or created a second core");
            shutdownFailure=false;run->Shutdown();RequireGameCoreAbsent();run.reset();
        });
        Case("existing-smoke-cannot-bypass-its-finite-sequence",[]{
            ResetLifecycle();loopResults.push_back({std::make_shared<const NativeSaveArchive>(88),L"diagnostic"});
            std::unique_ptr<HostRun> run(new HostRun(ExecutableDirectory()));run->Prepare("en_US");run->InitializeCore();
            Throws([&]{PlayBlock(run,true);},"unexpected LoadMenu input bypassed existing smoke assertions");
            Check(factories==1,"smoke rejection created a second host");run->Shutdown();RequireGameCoreAbsent();run.reset();
        });
        std::printf("EXTRACTED_LOAD_HANDOFF_PASS cases=%u checks=%u GAMECORE_ACTUAL_LOADED=false HWND_CREATED=false\n",cases,checks);
        return 0;
    }catch(const std::exception& error){std::fprintf(stderr,"EXTRACTED_LOAD_HANDOFF_FAILURE: %s\n",error.what());return 1;}
}
