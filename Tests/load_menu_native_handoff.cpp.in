static std::string Utf8(const std::wstring& text){
    if(text.empty())return {};
    const int count=WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,text.data(),static_cast<int>(text.size()),nullptr,0,nullptr,nullptr);
    if(count<=0)throw std::runtime_error("UTF-8 fixture failed");std::string result(static_cast<std::size_t>(count),'\0');
    if(WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,text.data(),static_cast<int>(text.size()),&result[0],count,nullptr,nullptr)!=count)
        throw std::runtime_error("UTF-8 fixture conversion failed");return result;
}
