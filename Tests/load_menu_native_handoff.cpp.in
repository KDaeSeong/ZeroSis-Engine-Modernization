class LoadPopupBoundaryFixture {
public:
    enum class TimerState {Released,Held,TransitionUnknown};
    HostState& host_;ScriptFixture& scripts_;
    UiPopupKind kind_=UiPopupKind::LoadMenu;
    bool active_=false,faulted_=false,dispatching_=false,stopping_=false;
    bool externalRouting_=true,timerRecoveryFailed_=false;
    bool loadMenuInput_=false,loadMenuReady_=false,gameMenuReady_=false,saveMenuReady_=false,saveMenuInput_=false;
    bool luaActive_=false,pullDownOpen=false,failAfterQueued=false;
    void* vm_=reinterpret_cast<void*>(static_cast<std::uintptr_t>(1));
    void* core_=reinterpret_cast<void*>(static_cast<std::uintptr_t>(1));
    std::unique_ptr<int> pregame_=std::unique_ptr<int>(new int(1));
    std::unique_ptr<GameFixture> game_=std::unique_ptr<GameFixture>(new GameFixture);
    LoadPopupBoundaryFixture* economicOwner_=nullptr;
    std::vector<std::unique_ptr<LoadPopupBoundaryFixture>> economicChildren_;
    std::shared_ptr<const UiLoadMenuCatalog> loadMenuCatalog_;
    std::vector<LoadMenuRequest> loadMenuRequests_;
    std::vector<int> gameMenuRequests_,saveMenuRequests_;
    int gameMenuOwner_=1,gameMenuTurn_=3,loadMenuCursorToken_=0;
    unsigned sequence_=0,revision_=0,escapes=0,queuedClose=0,completedCallbacks=0,cursorRestores=0;
    std::string shownSnapshot_;
    TimerState timerState_=TimerState::Released;
    UiInputKind loadMenuInputKind_=UiInputKind::PointerMove;
    std::function<void(LoadPopupBoundaryFixture&)> insideCloseCallback;
    explicit LoadPopupBoundaryFixture(HostState& host,UiPopupKind kind=UiPopupKind::LoadMenu):host_(host),scripts_(*host.scripts),kind_(kind){
        auto catalog=std::make_shared<UiLoadMenuCatalog>();
        catalog->profile=UiLoadMenuCatalog::Profile::OwnedCurrentExactBundleNoAdditionalContent;
        UiSaveMenuFile file;file.fileName="C:\\fixture-owned\\one.zssave";
        auto header=std::make_shared<UiSaveMenuHeader>();header->gameType=GAME_SINGLE_PLAYER;file.header=header;
        catalog->files.push_back(file);catalog->canLoad=[](const std::string&){return true;};loadMenuCatalog_=catalog;
        if(kind_==UiPopupKind::GameMenu)active_=luaActive_=true;
    }
    @@POPUP_REQUIRE@@
    void RequireLocalMenuPlayer(int owner,int turn){
        Require();if(!game_ || owner!=game_->owner || turn!=game_->turn)throw std::logic_error("SDK player/turn fixture mismatch");
    }
    @@POPUP_OWNED_PLAYER@@
    @@POPUP_LOAD_OWNER@@
    @@POPUP_FIND_LOAD@@
    @@POPUP_CAN_LOAD@@
    @@POPUP_QUEUE_LOAD@@
    void RequireSaveMenuOwner(){throw std::logic_error("Unexpected SaveMenu fixture branch");}
    void RequireGameMenuOwner(){Require();if(kind_!=UiPopupKind::GameMenu)throw std::logic_error("Unexpected parent fixture kind");}
    void RestoreLoadMenuCursor()noexcept{if(loadMenuCursorToken_){++cursorRestores;loadMenuCursorToken_=0;}}
    void RestoreGameMenuCursor()noexcept{}
    void ReleaseWarResources(){}
    void ApplyEconomicVisibility(bool){throw std::logic_error("Unexpected economic fixture branch");}
    bool IsActive()const{return active_;}
    static int OpenLoadMenuLua(){return 1;}
    static int ObserveActive(){return 2;}
    std::string WriteSnapshot(const char*){return "fixture-snapshot-no-files";}
    void Call(int(*function)(),void* output){
        if(dispatching_)throw std::logic_error("Reentrant callback fixture");
        dispatching_=true;scripts_.quiescent=false;
        try{
            if(function==&OpenLoadMenuLua)luaActive_=true;
            else if(function==&ObserveActive)*static_cast<bool*>(output)=luaActive_;
            else if(function==&UiInputDispatch::Dispatch){
                auto& input=*static_cast<UiInputRequest*>(output);
                if(input.kind==UiInputKind::LeftClick && input.key==101){pullDownOpen=true;input.consumed=true;}
                else if(input.kind==UiInputKind::KeyDown && input.key==VK_ESCAPE){
                    ++escapes;input.consumed=true;
                    if(pullDownOpen)pullDownOpen=false;
                    else{
                        QueueLoadMenuRequest(LoadMenuRequest::Kind::Close,nullptr);++queuedClose;
                        if(insideCloseCallback)insideCloseCallback(*this);
                        if(failAfterQueued)throw std::runtime_error("Injected original callback fixture failure");
                        luaActive_=false;
                    }
                }else if(input.kind==UiInputKind::LeftClick && input.key==202){
                    loadMenuCursorToken_=1;
                    QueueLoadMenuRequest(LoadMenuRequest::Kind::Load,loadMenuCatalog_->files[0].fileName.c_str());
                    QueueLoadMenuRequest(LoadMenuRequest::Kind::Close,nullptr);++queuedClose;luaActive_=false;input.consumed=true;
                }
            }else throw std::logic_error("Unknown callback fixture function");
            dispatching_=false;scripts_.quiescent=true;++completedCallbacks;
        }catch(...){dispatching_=false;scripts_.quiescent=true;Fault();throw;}
    }
    @@POPUP_OPEN_LOAD@@
    @@POPUP_HAS_LOAD@@
    @@POPUP_TAKE_LOAD@@
    bool DispatchInput(UiInputKind kind,std::uint64_t key,double delta=0.0){
        Require();if(!active_ || faulted_)return false;
        UiInputRequest request;request.kind=kind;request.key=key;request.delta=delta;
        @@POPUP_DISPATCH_LOAD@@
        // The original parent GameMenu Lua is outside this regression fixture.
        if(kind_==UiPopupKind::GameMenu)return false;
        throw std::logic_error("Unexpected popup input fixture kind");
    }
    @@POPUP_CLOSE_LOAD_PREFIX@@
    @@POPUP_STOP@@
    @@POPUP_FAULT@@
};
class RouterPopupBoundaryFixture:public LoadPopupBoundaryFixture {
public:
    std::function<void(const std::vector<LoadMenuRequest>&)> observedTake;
    explicit RouterPopupBoundaryFixture(HostState& host,UiPopupKind kind):LoadPopupBoundaryFixture(host,kind){}
    void CloseInformationalPopup(){
        if(kind_==UiPopupKind::LoadMenu)LoadPopupBoundaryFixture::CloseInformationalPopup();
        else{events.push_back("FixtureParentClose");active_=luaActive_=false;host_.popupVisible=false;}
    }
    std::vector<LoadMenuRequest> TakeLoadMenuRequests(){
        auto value=LoadPopupBoundaryFixture::TakeLoadMenuRequests();if(observedTake)observedTake(value);return value;
    }
};
class WindowCloseUiBoundaryFixture {
public:
    HostState& host_;
    std::unique_ptr<RouterPopupBoundaryFixture> popup_,suspendedGameMenu_,suspendedCity_,suspendedEconomic_;
    UiPopupKind kind_=UiPopupKind::LoadMenu;
    std::vector<int> pending_,leaderWarStates_;
    bool closePending_=false;
    int opened_=0,gameMenuOpened_=0;
    unsigned observedCloseCount=0,observedTakeCalls=0,discardCalls=0,observedEscapes=0,observedQueuedClose=0;
    bool takeAfterCallback=false;
    explicit WindowCloseUiBoundaryFixture(HostState& host):host_(host),
        popup_(new RouterPopupBoundaryFixture(host,UiPopupKind::LoadMenu)),
        suspendedGameMenu_(new RouterPopupBoundaryFixture(host,UiPopupKind::GameMenu)){
        popup_->OpenLoadMenu();
        popup_->observedTake=[this](const std::vector<LoadMenuRequest>& requests){
            ++observedTakeCalls;
            observedEscapes=popup_->escapes;observedQueuedClose=popup_->queuedClose;
            takeAfterCallback=!popup_->dispatching_ && !popup_->loadMenuInput_ && host_.scripts->IsQuiescent();
            if(requests.size()==1 && requests[0].kind==LoadMenuRequest::Kind::Close && requests[0].fileName.empty())++observedCloseCount;
        };
    }
    @@WINDOW_CLOSE_REQUIRE@@
    bool HasCaptureDecision()const{return false;}bool HasLeaderDecision()const{return false;}
    bool HasEconomicContext()const{return false;}bool EconomicScopeMatches()const{return true;}
    void StopEconomicContexts(){throw std::logic_error("Unexpected economic close fixture");}
    void DiscardIdleProduction(){++discardCalls;}
    bool Update(){
        Require();bool changed=false;
        @@WINDOW_CLOSE_RETURN@@
        if(popup_ && kind_==UiPopupKind::GameMenu && !popup_->IsActive()){
            // Other router context teardown is an explicit boundary fixture.
            popup_->Stop();popup_.reset();host_.popupVisible=false;changed=true;
        }
        return changed;
    }
    @@WINDOW_CLOSE_CURRENT@@
    @@WINDOW_CLOSE_ALL@@
};
struct NativeSaveCatalog {
    std::vector<UiSaveMenuFile> listed;std::shared_ptr<const NativeSaveArchive> current=std::make_shared<const NativeSaveArchive>(42);
    bool fail=false;unsigned reads=0;
    std::vector<UiSaveMenuFile> List()const{return listed;}
    std::shared_ptr<const NativeSaveArchive> ReadLoadArchive(const std::string& path,const UiSaveMenuFile& original,const std::vector<unsigned char>& bytes){
        ++reads;events.push_back("SealArchive");
        if(fail || bytes!=fixtureManifest || listed.size()!=1 || path!=original.fileName ||
           original.observedFileIdentity!=listed[0].observedFileIdentity ||
           original.observedChecksum!=listed[0].observedChecksum || !original.header)
            throw std::runtime_error("Catalog fixture rejected changed observed identity");
        return current;
    }
};
