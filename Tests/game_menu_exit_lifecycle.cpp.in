// The popup's actual ownership, input, close, request and handoff methods run
// below; only protected Lua dispatch/observations and SDK interfaces are fakes.
class PopupBoundaryFixture {
public:
    enum class TimerState {Released,Held,TransitionUnknown};
    HostState host_;ScriptFixture& scripts_=*host_.scripts;std::unique_ptr<GameFixture> game_{new GameFixture};
    UiPopupKind kind_=UiPopupKind::ExitConfirm;void* pregame_=this;void* vm_=this;
    bool externalRouting_=true,dispatching_=false,active_=false,faulted_=false,stopping_=false;
    bool gameMenuInput_=false,gameMenuReady_=false,topPanelInput_=false;
    bool exitConfirmInput_=false,exitConfirmYesInput_=false,exitConfirmCloseInput_=false,exitConfirmClosed_=false;
    UiInputKind gameMenuInputKind_=UiInputKind::KeyDown,topPanelInputKind_=UiInputKind::KeyDown,exitConfirmInputKind_=UiInputKind::KeyDown;
    int gameMenuOwner_=1,gameMenuTurn_=3,topPanelOwner_=1;bool topPanelPopup_=false;
    TimerState timerState_=TimerState::Released;unsigned sequence_=0,revision_=0;
    std::string shownSnapshot_;std::vector<GameMenuRequest> gameMenuRequests_;
    bool luaActive_=false,omitPop_=false,duplicateExit_=false,forceWrongTarget_=false;
    bool openFailure_=false,gameplayMutation_=false;
    @@POPUP_REQUIRE@@
    @@LOCAL_PLAYER@@
    @@OWNED_PLAYER@@
    @@EXIT_OWNER@@
    @@GAME_OWNER@@
    @@MARK_CLOSED@@
    @@QUEUE_EXIT@@
    @@QUEUE_MENU@@
    @@TAKE_MENU@@
    @@HAS_MENU@@
    @@OPEN_POPUP@@
    void Fault(){faulted_=true;active_=false;gameMenuRequests_.clear();gameMenuReady_=false;}
    static int OpenExitConfirmLua(lua_State*){return 1;}
    static int ObserveActive(lua_State*){return 2;}
    std::string WriteSnapshot(const char*){events.push_back("PopupSnapshot");return "fixture";}
    void RestoreGameMenuCursor(){}
    std::vector<UiInputTarget> InputTargets(){
        UiInputTarget yes;yes.key=11;yes.id=forceWrongTarget_?"DifferentButton":"Yes";
        UiInputTarget no;no.key=12;no.id="No";return {yes,no};
    }
    void Call(int(*function)(lua_State*),void* value){
        dispatching_=true;
        try{
            if(function==&OpenExitConfirmLua){
                events.push_back("LuaPushModal");if(openFailure_)throw std::runtime_error("fixture Lua open failure");luaActive_=true;
                if(gameplayMutation_)++host_.stateStamp;
            }else if(function==&ObserveActive)*static_cast<bool*>(value)=luaActive_;
            else if(function==&UiInputDispatch::Dispatch){
                auto& input=*static_cast<UiInputRequest*>(value);input.consumed=false;
                const bool yes=input.kind==UiInputKind::LeftClick && input.key==11;
                const bool no=input.kind==UiInputKind::LeftClick && input.key==12;
                const bool escape=input.kind==UiInputKind::KeyDown && input.key==VK_ESCAPE;
                if(yes || no || escape){
                    if(!omitPop_){MarkExitConfirmClosed();luaActive_=false;events.push_back("LuaPopModal");}
                    if(yes){QueueConfirmedExit();if(duplicateExit_)QueueConfirmedExit();}
                    input.consumed=true;
                }
            }else throw std::logic_error("Unknown fixture Lua function");
            dispatching_=false;
        }catch(...){dispatching_=false;throw;}
    }
    bool DispatchInput(UiInputKind kind,std::uint64_t key,double delta=0.0){
        Require();if(!active_)return false;
        UiInputRequest request;request.kind=kind;request.key=key;request.delta=delta;
        @@POPUP_DISPATCH@@
        return false;
    }
};

