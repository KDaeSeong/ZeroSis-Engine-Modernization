// Exact production fragments are inserted by the Python runner. The SDK,
// Lua callbacks, modal lifetimes, archive capture and replacement filesystem
// service below are explicit fixtures. No game or user save is opened.
#include <Windows.h>
#include <werapi.h>
#include <algorithm>
#include <cstdio>
#include <cstdint>
#include <cstring>
#include <functional>
#include <memory>
#include <stdexcept>
#include <string>
#include <utility>
#include <vector>
#include "UiLoadMenuContract.h"

static unsigned checks=0,cases=0;
static void Check(bool value,const char* reason){++checks;if(!value)throw std::runtime_error(reason);}
template<class F> static void Throws(F&& fn,const char* reason){
    bool rejected=false;try{fn();}catch(const std::exception&){rejected=true;}Check(rejected,reason);
}
template<class F> static void Case(const std::string& name,F&& fn){
    fn();++cases;std::printf("OVERWRITE_HANDOFF_CASE_PASS=%s\n",name.c_str());
}

namespace ZeroSisHost {
static const int MAX_PLAYERS=64;
enum PlayerTypes {FixturePlayer=1};
enum class UiPopupKind {GameMenu,SaveMenu,LoadMenu,UnitPanel,TopPanel};
enum class UiInputKind {LeftClick,RightClick,KeyDown,PointerMove,TextInput};
struct UiInputRequest {UiInputKind kind=UiInputKind::PointerMove;std::uint64_t key=0;double delta=0;bool consumed=false;};
struct UiInputDispatch {static int Dispatch(){return 1;}};
struct LockFixture {bool held=true;bool HeldByCurrentThread()const{return held;}};
struct CommandsFixture {bool quiescent=true;bool IsQuiescent()const{return quiescent;}};
struct ScriptFixture {bool quiescent=true;bool IsQuiescent()const{return quiescent;}};
struct HostFixture {
    DWORD gameThread=GetCurrentThreadId();LockFixture gameLock;CommandsFixture localCommands;
    bool localSdkSessionBound=true,popupVisible=true,autoSaveRunning=false;ScriptFixture* scripts=nullptr;
    unsigned gameplay=71;std::function<void(bool,bool)> autoSave;
};
struct ICvPlayer1 {
