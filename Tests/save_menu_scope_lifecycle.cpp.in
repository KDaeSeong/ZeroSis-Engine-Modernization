// Nonwindow component fixture. Native methods/fragments are inserted verbatim
// from the current headers; SDK/Lua/OS and snapshot-I/O APIs are substitutes.
#include <array>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <deque>
#include <exception>
#include <functional>
#include <memory>
#include <stdexcept>
#include <string>
