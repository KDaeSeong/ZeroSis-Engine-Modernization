+        kPostDefines.Release();
+        kInsert.Release();
+        if(!db->Execute("UPDATE Resources SET ResourceUsage = 1 WHERE EXISTS (SELECT * FROM Unit_ResourceQuantityRequirements WHERE ResourceType = Type)")) return false;
+        if(!db->Execute("UPDATE Resources SET ResourceUsage = 2 where Happiness > 0")) return false;
+        Database::Results kInsertDefine;
+        if(!db->Execute(kInsertDefine, "INSERT OR REPLACE INTO Defines(Name, Value) VALUES(?, ?);")) return false;
+        if(!InsertGameDefine(kInsertDefine, "MAX_CIV_PLAYERS", MAX_CIV_PLAYERS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "MAX_CIV_TEAMS", MAX_CIV_TEAMS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "MAX_MAJOR_CIVS", MAX_MAJOR_CIVS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "MAX_MINOR_CIVS", MAX_MINOR_CIVS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "MAX_PLAYERS", MAX_PLAYERS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "MAX_TEAMS", MAX_TEAMS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "BARBARIAN_PLAYER", BARBARIAN_PLAYER)) return false;
+        if(!InsertGameDefine(kInsertDefine, "BARBARIAN_TEAM", BARBARIAN_TEAM)) return false;
+        if(!InsertGameDefine(kInsertDefine, "NUM_CITY_PLOTS", NUM_CITY_PLOTS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "CITY_HOME_PLOT", CITY_HOME_PLOT)) return false;
+        if(!InsertGameDefine(kInsertDefine, "CITY_PLOTS_RADIUS", CITY_PLOTS_RADIUS)) return false;
+        if(!InsertGameDefine(kInsertDefine, "CITY_PLOTS_DIAMETER", CITY_PLOTS_DIAMETER)) return false;
+        return true;
+    }();
+    if(success && transaction.Commit()) return true;
+    if(!transaction.Rollback()) throw std::runtime_error("GameCore postprocessing rollback failed; discard this database connection");
+    return false;
