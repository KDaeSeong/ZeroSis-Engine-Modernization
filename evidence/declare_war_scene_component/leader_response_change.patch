+"""Exercise the narrow original LeaderHead message tuple contract."""
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from ui_pixel_scene import (DIPLO_UI_STATE_DEFAULT_ROOT_ENUM_VALUE,
+                            DIPLO_UI_STATE_WAR_DECLARED_BY_HUMAN_ENUM_VALUE,
+                            LEADERHEAD_ANIM_INTRO_ENUM_VALUE,
+                            LEADERHEAD_ANIM_ATTACKED_ENUM_VALUE,
+                            valid_leader_message)
+
+base = {'player': 1, 'state': DIPLO_UI_STATE_DEFAULT_ROOT_ENUM_VALUE,
+        'animation': LEADERHEAD_ANIM_INTRO_ENUM_VALUE, 'data1': 0,
+        'text': 'original leader speech'}
+assert valid_leader_message(base)
+
+war_response = dict(base, state=DIPLO_UI_STATE_WAR_DECLARED_BY_HUMAN_ENUM_VALUE,
+                    animation=LEADERHEAD_ANIM_ATTACKED_ENUM_VALUE)
+assert valid_leader_message(war_response)
+
+invalid_messages = (
+    dict(base, state=DIPLO_UI_STATE_WAR_DECLARED_BY_HUMAN_ENUM_VALUE),
+    dict(base, animation=LEADERHEAD_ANIM_ATTACKED_ENUM_VALUE),
+    dict(war_response, data1=1),
+    dict(war_response, state=2),
+    dict(war_response, player=-1),
+    dict(war_response, player=True),
+    dict(war_response, text=''),
+    dict(war_response, text=None),
+)
+for message in invalid_messages:
+    assert not valid_leader_message(message), message
+
+assert not valid_leader_message(None)
